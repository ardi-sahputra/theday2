# =============================================================================
# TheDay — template .env untuk STAGING (staging.theday.id)
#
# Copy ke .env di ~/domains/staging.theday.id/public_html, lalu isi yang <...>.
# JANGAN commit .env asli.
#
# Beda utama dari production:
#   - APP_ENV=staging          -> mengaktifkan StagingBasicAuth + header noindex
#   - APP_DEBUG=true           -> boleh, ini bukan publik
#   - DB terpisah              -> tidak pernah menyentuh data prod
#   - MAIL_MAILER=log          -> email masuk ke log, tidak terkirim ke user asli
#   - MIDTRANS_IS_PRODUCTION=false -> sandbox, tidak ada transaksi nyata
#   - AWS_BUCKET terpisah      -> upload staging tidak mengotori bucket prod
# =============================================================================

APP_NAME="TheDay (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=https://staging.theday.id

# Gerbang basic auth. Wajib diisi — tanpa ini staging terbuka ke publik.
STAGING_AUTH_USER=staging
STAGING_AUTH_PASSWORD=<ganti-password-kuat>

MAINTENANCE_MODE=false
MAINTENANCE_ALLOWED_IPS=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

ADMIN_EMAIL=<email-admin-staging>
ADMIN_PASSWORD=<password-admin-staging>
ADMIN_NAME="Admin Staging"

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (BUAT BARU di hPanel, jangan pakai punya prod) -----------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u144336260_staging_theday
DB_USERNAME=u144336260_staging_theday
DB_PASSWORD=<password-db-staging>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=staging.theday.id
SANCTUM_STATEFUL_DOMAINS=staging.theday.id

CACHE_STORE=database
CACHE_PREFIX=theday_stg_cache
SESSION_COOKIE=theday_stg_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail: JANGAN pakai SMTP asli. Email staging harus mati. ----------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="staging@theday.id"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_MAPS_API_KEY=<key-atau-kosongkan>

# --- Pembayaran: WAJIB sandbox ---------------------------------------------
MIDTRANS_SERVER_KEY=<sandbox-server-key>
MIDTRANS_CLIENT_KEY=<sandbox-client-key>
MIDTRANS_IS_PRODUCTION=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_APP_NAME="${APP_NAME}"

# --- Object storage: bucket terpisah dari prod ------------------------------
AWS_ACCESS_KEY_ID=<key>
AWS_SECRET_ACCESS_KEY=<secret>
AWS_DEFAULT_REGION=auto
AWS_BUCKET=<bucket-staging>
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Google OAuth: tambahkan redirect URI staging di Google Console ---------
GOOGLE_CLIENT_ID=<client-id>
GOOGLE_CLIENT_SECRET=<client-secret>
GOOGLE_REDIRECT_URI=https://staging.theday.id/auth/google/callback

DEEPSEEK_API_KEY=<key-atau-kosongkan>
